# SentinelScope Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application
APP_NAME=SentinelScope
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database (defaults to SQLite; supports PostgreSQL: postgresql+psycopg://user:pass@host:port/dbname)
DATABASE_URL=sqlite:///./sentinelscope.db

# Ingestion / Feed Settings
FEED_REQUEST_TIMEOUT_SECONDS=10
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
FEED_API_KEY=

# AI Enrichment (Person 3 Interface)
AI_PROVIDER=deterministic_fallback
AI_API_KEY=
AI_MODEL=mock-v1

